# Sourced by the vendored `build` script (bash syntax; variables only).
#
# tempfs size for the in-container build fs. Upstream builds all gardener flavors with the
# default 2G; the build container also runs with --memory 4G (tmpfs pages count against it),
# so do NOT raise this above ~3G without also raising --container-run-opts memory.
# Symptom of too small: "failed to write (No space left on device)" during package install.
tempfs_size=2G
