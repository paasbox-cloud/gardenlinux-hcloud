#!/usr/bin/env bash
set -Eeuo pipefail

# Same sshd conventions as features/hcloud (see there for the full rationale):
# 1) key-only root login — on Robot there is no metadata/cc_ssh key delivery at all; keys
#    arrive via rescue-injection (deploy/test) or the pull-onboarding agent, and both
#    target root. Password auth stays off.
sed -i 's/^PermitRootLogin no$/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config
grep -q '^PermitRootLogin prohibit-password$' /etc/ssh/sshd_config || {
	echo "robot/exec.config: expected PermitRootLogin line not found in sshd_config (upstream ssh feature changed?)" >&2
	exit 1
}
# 2) GL's sshd_config ships without the Debian-standard sshd_config.d include — drop-ins are
#    dead letters otherwise (2026-07-07 finding, usi reboot lockout). Since 2150.11.0 upstream has
#    one at the END, where a drop-in cannot override anything; line 1 must be the Include.
[ "$(head -n 1 /etc/ssh/sshd_config)" = 'Include /etc/ssh/sshd_config.d/*.conf' ] || {
	sed -i '\|^Include /etc/ssh/sshd_config\.d/\*\.conf$|d' /etc/ssh/sshd_config
	sed -i '1i Include /etc/ssh/sshd_config.d/*.conf' /etc/ssh/sshd_config
}

# SECURITY — close the rpcbind/111 reflector in the image (same fix as features/hcloud). The
# vendored `gardener` feature installs `nfs-common`, which ships rpcbind; systemd socket-activates
# it on 0.0.0.0:111. Dedicated Robot nodes are NOT covered by the per-project Hetzner Cloud
# Firewalls at all (those attach to hcloud servers only), so a rebuilt Robot node re-exposes 111
# unless it is masked in the image. This is the durable image-level twin of nodepool-core's runtime
# AutosetupHardening (which only runs on the Reimager path).
#
# MASK, not disable: rpcbind.socket is socket-activated; a bare disable lets systemd respawn it on
# the first packet to 111. nfs-common (NFS *client* binaries) is KEPT — masking only removes the
# portmapper listener; NFSv4 needs no rpcbind. Mirrors `systemctl mask sshguard` in features/ssh.
systemctl mask rpcbind.service rpcbind.socket rpc-statd.service
