#!/usr/bin/env bash
set -Eeuo pipefail

# Same trim as the upstream openstack/aws platform features: growpart is done in the GL
# initramfs, growroot by systemd(-repart), NTP by systemd-timesyncd — cloud-init must not
# fight them.
mv /etc/cloud/cloud.cfg /etc/cloud/cloud.cfg.bak
grep -v "^ - growpart$" /etc/cloud/cloud.cfg.bak | grep -v "^ - resizefs$" | grep -v "^ - ntp$" > /etc/cloud/cloud.cfg
rm /etc/cloud/cloud.cfg.bak

# hcloud root-access convention (see 60-hcloud-root-access.cfg): the GL ssh feature hardens
# sshd to `PermitRootLogin no`, but on hcloud the platform delivers the instance ssh key to
# ROOT (vendor-data pins default_user=root — verified GL1 boot test 2026-07-07), so a GL image
# with that hardening has NO working key path at all. Relax to key-only root login; password
# auth stays off. Fail loudly if upstream changes the line we patch.
sed -i 's/^PermitRootLogin no$/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config
grep -q '^PermitRootLogin prohibit-password$' /etc/ssh/sshd_config || {
	echo "hcloud/exec.config: expected PermitRootLogin line not found in sshd_config (upstream ssh feature changed?)" >&2
	exit 1
}

# GL's custom sshd_config ships WITHOUT the Debian-standard sshd_config.d include, so every
# drop-in is silently dead (found 2026-07-07: USI reboot lockout — cc_ssh's key lives in
# tmpfs /root on usi, and the /etc/ssh/authorized_keys.d fallback needs a drop-in to be
# read). Add the include at the TOP (first-match-wins in sshd config).
grep -q '^Include /etc/ssh/sshd_config.d/\*.conf' /etc/ssh/sshd_config || \
	sed -i '1i Include /etc/ssh/sshd_config.d/*.conf' /etc/ssh/sshd_config

# USI variant only: point in-place updates at OUR artifact repo. os-gardenlinux's
# inplace-update.sh reads /etc/gardenlinux/usirepo.conf (whole file = one OCI repo ref) and
# passes it as `gardenlinux-update --repo ...`; without the file the tool defaults to
# ghcr.io/gardenlinux/gardenlinux, which will never carry our hcloud cname. Artifacts there
# must be signed with cert/oci-sign — gardenlinux-update verifies against the baked
# /etc/gardenlinux/oci_signing_key.pem (written by the vendored _usi exec.post).
# NOTE: private/NAT nodes need egress to this registry — requirement R5.
if grep ',_usi,' > /dev/null <<< ",$BUILDER_FEATURES,"; then
	mkdir -p /etc/gardenlinux
	# The real org namespace (ghcr.io/paasbox-cloud), not a personal placeholder. The publish
	# pipeline that puts SIGNED update images at this ref is still open, so until it lands there is
	# nothing here for gardenlinux-update to pull — the file is written now so that a node built
	# today looks in the right place once there is something to find.
	echo "ghcr.io/paasbox-cloud/gardenlinux-hcloud" > /etc/gardenlinux/usirepo.conf
fi

# SECURITY — close the rpcbind/111 reflector in the image. The upstream `gardener` feature installs
# `nfs-common`, which pulls in rpcbind; systemd socket-activates it on 0.0.0.0:111, so every
# GL-based Gardener node (seed, MCM shoot worker, pool-adopted node) is a UDP-111 DDoS-reflection
# amplifier unless a Hetzner firewall blocks 111. Those firewalls are per-project and
# selector-based: they cover the servers whose labels they select, and a node adopted into a pool
# carries whatever labels its adopter gave it — so close it in the image itself, where the set is
# "every node built from this image" and needs no label to be right.
# This is the cloud analogue of nodepool-core's dedicated AutosetupHardening; keeping the fix in
# THIS hcloud-local feature (not the upstream `gardener` feature) preserves upstream compatibility.
#
# MASK, not disable: rpcbind.socket is socket-activated, so a bare disable/stop lets systemd
# re-spawn rpcbind on the first packet to 111 (same reasoning as nodepool-core provider.go).
# nfs-common (the NFS *client* binaries) is KEPT — masking only removes the portmapper listener;
# NFSv4 mounts do not need it. A node that genuinely needs NFSv3/rpcbind must unmask explicitly.
# Matches the existing `systemctl mask sshguard` precedent in features/ssh/exec.config.
systemctl mask rpcbind.service rpcbind.socket rpc-statd.service
