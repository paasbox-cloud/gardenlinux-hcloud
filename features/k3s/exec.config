#!/usr/bin/env bash
set -Eeuo pipefail

# k3s from the image. Rationale for every choice here: features/k3s/README.md.

feature_dir="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")"
# shellcheck source=k3s.pin
. "$feature_dir/k3s.pin"

# ── 1. the binary, verified three ways ──────────────────────────────────────────────────────────
# exec.config runs in the build chroot, which shares the build container's network (the package
# install a few steps earlier runs in the same chroot), so the release is fetched here rather than by a
# pre-build step that every local build and every CI job would have to remember. A build therefore
# needs github.com in addition to packages.gardenlinux.io.
#
# The pin in k3s.pin is the trust anchor. The release's own sha256sum-<arch>.txt must agree with it
# (a re-published asset is caught even before the download), and the downloaded bytes must match both.
arch="$(dpkg --print-architecture)"
case "$arch" in
	amd64) asset=k3s ;;
	arm64) asset=k3s-arm64 ;;
	*) echo "k3s/exec.config: no k3s release asset for $arch" >&2; exit 1 ;;
esac
pin_var="K3S_SHA256_$arch"
pinned="${!pin_var:-}"
[[ "$pinned" =~ ^[0-9a-f]{64}$ ]] || { echo "k3s/exec.config: k3s.pin has no sha256 for $arch" >&2; exit 1; }

base="https://github.com/k3s-io/k3s/releases/download/${K3S_VERSION//+/%2B}"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
fetch() { curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors --connect-timeout 20 -o "$2" "$1"; }

fetch "$base/sha256sum-$arch.txt" "$tmp/sha256sum.txt"
released="$(awk -v a="$asset" '$2 == a || $2 == "*" a { print $1 }' "$tmp/sha256sum.txt")"
if [ "$released" != "$pinned" ]; then
	echo "k3s/exec.config: $K3S_VERSION $asset — the release says '${released:-<absent>}', k3s.pin says $pinned" >&2
	exit 1
fi
fetch "$base/$asset" "$tmp/k3s"
echo "$pinned  $tmp/k3s" | sha256sum --check --strict --quiet
install -m 0755 "$tmp/k3s" /usr/bin/k3s
echo "k3s/exec.config: /usr/bin/k3s = $K3S_VERSION ($arch, sha256 $pinned)"

# The binary is multi-call: invoked as kubectl/crictl/ctr it becomes that tool.
for tool in kubectl crictl ctr; do
	ln -sf k3s "/usr/bin/$tool"
done

# Prove the binary runs and is the version we pinned (amd64 on an arm64 builder runs via binfmt).
reported="$(/usr/bin/k3s --version)"
echo "$reported"
grep -qF "k3s version $K3S_VERSION " <<< "$reported" || {
	echo "k3s/exec.config: /usr/bin/k3s does not report $K3S_VERSION" >&2
	exit 1
}

# ── 2. the kernel has what k3s needs ────────────────────────────────────────────────────────────
# Checked here so a kernel that lost a module is a failed BUILD, not a node whose pods have no network.
# modinfo also resolves built-in modules (modules.builtin.modinfo), so =y and =m both pass.
mapfile -t kvers < <(find /lib/modules -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)
[ "${#kvers[@]}" -ge 1 ] || { echo "k3s/exec.config: no kernel in /lib/modules" >&2; exit 1; }
for kver in "${kvers[@]}"; do
	for mod in overlay br_netfilter nf_conntrack vxlan xt_conntrack xt_comment xt_mark xt_multiport \
		nf_nat nf_tables nft_compat \
		dm_mod dm_thin_pool dm_snapshot ext4 xfs; do
		modinfo -k "$kver" "$mod" > /dev/null 2>&1 || {
			echo "k3s/exec.config: kernel $kver lacks module $mod" >&2
			exit 1
		}
	done
done

# ── 3. units: the roles OFF, the plumbing ON ────────────────────────────────────────────────────
# k3s.service and k3s-agent.service ship DISABLED; provisioning picks one (k3s-role, README). The
# preset keeps a first-boot `preset-all` from enabling them behind provisioning's back — Debian's
# default preset enables everything that has an [Install] section.
systemctl preset k3s.service k3s-agent.service
for unit in k3s.service k3s-agent.service; do
	state="$(systemctl is-enabled "$unit" 2> /dev/null || true)"
	[ "$state" = disabled ] || { echo "k3s/exec.config: $unit is '$state' in the image, not disabled" >&2; exit 1; }
done
systemctl enable k3s-vg0.service k3s-thinpool-monitor.timer lvm2-monitor.service k3s-persist-root-keys.service \
	k3s-stop-pods.service metadata-guard.service
# The metadata guard must be what both roles require, or a role could start without the rule (README,
# "Metadata guard"). `enable` made the .requires links from its [Install] section; check they are there.
for unit in k3s.service k3s-agent.service; do
	[ -L "/etc/systemd/system/$unit.requires/metadata-guard.service" ] || {
		echo "k3s/exec.config: $unit does not require metadata-guard.service" >&2
		exit 1
	}
done

# ── 4. LVM thin-pool policy actually resolves ───────────────────────────────────────────────────
# lvmlocal.conf is ours (file.include); ask lvm what it resolved rather than trusting the file.
eff="$(lvmconfig activation/thin_pool_autoextend_threshold 2> /dev/null | tr -dc 0-9)"
[ "$eff" = 80 ] || { echo "k3s/exec.config: thin_pool_autoextend_threshold resolves to '${eff:-?}', not 80" >&2; exit 1; }

# ── 5. sshd reads /etc/ssh/authorized_keys.d/%u ─────────────────────────────────────────────────
# Our drop-in (sshd_config.d/50-k3s-authorized-keys.conf) is dead without the Include line, which GL's
# sshd_config lacks. hcloud and robot add the same line with the same idempotent guard; whichever
# exec.config runs first adds it, the other finds it (the builder's feature order is not ours to rely on).
grep -q '^Include /etc/ssh/sshd_config.d/\*.conf' /etc/ssh/sshd_config || \
	sed -i '1i Include /etc/ssh/sshd_config.d/*.conf' /etc/ssh/sshd_config
