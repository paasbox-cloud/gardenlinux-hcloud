#!/usr/bin/env bash
set -Eeuo pipefail

# OpenZFS for Garden Linux (the ZFS-CSI precondition).
#
# WHY A FEATURE AND NOT A RUNTIME INSTALL. A local-PV CSI (openebs ZFS-LocalPV) pins a volume to a
# node BY NAME and cannot move it, so the pool has to exist on a box that keeps both its disk and its
# node name across a Machine replacement (nodepool-core's ReadyBound). Installing ZFS at first boot
# would mean building a kernel module on a node whose only egress may be the tunnel the join itself
# brings up — the same trap the golden image's prebake exists to avoid. So it goes in the image.
#
# WHY DKMS HERE AND NOT VIA THE POSTINST. zfs-dkms' postinst builds for `uname -r` — inside this
# chroot that is the BUILD HOST's kernel, which is not the kernel this image ships. The module would
# land under the wrong /lib/modules and the image would boot without ZFS, silently. So the postinst's
# attempt is tolerated and the module is then built explicitly for the kernel that is INSTALLED here.
#
# SECURE BOOT: an out-of-tree module is unsigned, and a Secure-Boot-enforcing flavour (_usi, signed)
# will refuse to load it. That is why this feature is opt-in and aimed at the Robot/dedicated
# flavours, where Secure Boot is not enforced — see README.md.

# ── 1. the kernel this image actually ships ──────────────────────────────────────────────────────
# Exactly one kernel is expected. Two would make "which one did we build for" a coin toss, and zero
# means the feature was combined with a flavour that ships no kernel at all.
mapfile -t kvers < <(find /lib/modules -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)
if [ "${#kvers[@]}" -ne 1 ]; then
	echo "zfs/exec.config: expected exactly one kernel in /lib/modules, found ${#kvers[@]}: ${kvers[*]:-none}" >&2
	echo "  (this feature includes 'metal', which installs linux-image-\$arch; check the flavour)" >&2
	exit 1
fi
kver="${kvers[0]}"
echo "zfs/exec.config: building OpenZFS for kernel $kver"

# ── 2. the module, built for THAT kernel ─────────────────────────────────────────────────────────
# The headers must match the kernel, or dkms builds against whatever else is lying around.
[ -d "/lib/modules/$kver/build" ] || [ -d "/usr/src/linux-headers-$kver" ] || {
	echo "zfs/exec.config: no kernel headers for $kver — linux-headers-\$arch did not match linux-image-\$arch" >&2
	exit 1
}

zfs_ver="$(dkms status -m zfs 2>/dev/null | head -1 | sed -n 's/^zfs[,/ ]*\([^,:]*\).*/\1/p' | tr -d ' ')"
[ -n "$zfs_ver" ] || zfs_ver="$(find /usr/src -maxdepth 1 -name 'zfs-*' -printf '%f\n' | head -1 | sed 's/^zfs-//')"
[ -n "$zfs_ver" ] || { echo "zfs/exec.config: zfs-dkms is installed but no source tree under /usr/src/zfs-*" >&2; exit 1; }

dkms build  -m zfs -v "$zfs_ver" -k "$kver"
dkms install -m zfs -v "$zfs_ver" -k "$kver" --force
depmod -a "$kver"

# ── 3. prove it, in the image ────────────────────────────────────────────────────────────────────
# The whole point of doing this at build time is that a failure is a failed BUILD, not a node that
# boots and then cannot mount anything. modinfo reads the module file, so it works without loading.
modinfo -k "$kver" zfs >/dev/null || {
	echo "zfs/exec.config: the zfs module is not registered for $kver after dkms install" >&2
	exit 1
}
for tool in zpool zfs; do
	command -v "$tool" >/dev/null || { echo "zfs/exec.config: $tool missing — zfsutils-linux did not install" >&2; exit 1; }
done
modinfo -k "$kver" zfs | sed -n 's|^version:[[:space:]]*|zfs/exec.config: module version |p'

# ── 4. bring a pool back after a reboot ──────────────────────────────────────────────────────────
# The pool does not exist yet — the CSI creates it. Enabling these now means that when it does
# exist, it is imported and mounted at boot without anybody logging in. Enabling a unit whose pool
# is absent is a no-op, which is why this is safe in a generic image.
systemctl enable zfs-import-cache.service zfs-mount.service zfs.target 2>/dev/null || true
# NOT in the initramfs: root stays ext4 and ZFS carries DATA only, so the module is needed after
# pivot-root, not before. Keeping it out avoids rebuilding the initrd for an out-of-tree module.

# ── 5. put the build chain away ──────────────────────────────────────────────────────────────────
# A production node has no business carrying a compiler. The module is built and installed; the
# source and toolchain are not needed again until the next IMAGE build. Kept deliberately: dkms +
# the source tree, so `dkms status` on a node still reports what it is running.
apt-get purge -y --auto-remove 'linux-headers-*' >/dev/null 2>&1 || true
apt-get clean
# Report rather than assume: if the toolchain is still here, the purge pattern missed and the image
# ships a compiler. Not fatal — an image that works beats an image that is tidy — but say so.
command -v gcc >/dev/null && echo "zfs/exec.config: NOTE gcc is still installed (header purge did not take it)" >&2 || true
